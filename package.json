    "react",
    "tailwindcss"
  ],
  "homepage": "https://wunderui.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kl-webmedia/wunderui-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Kl-webmedia/wunderui-mcp/issues"
  },
  "author": "WunderUI",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
